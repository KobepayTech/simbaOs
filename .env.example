# Copy to .env and replace every value below before starting SimbaOS.
# The application refuses to boot in production while any placeholder remains.

# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=replace-with-strong-password

# Generate with: openssl rand -hex 32   (must be at least 32 characters)
JWT_SECRET=replace-with-long-random-secret

# First-run administrator account. Must be at least 12 characters.
ADMIN_EMAIL=admin@simbaos.local
ADMIN_PASSWORD=replace-with-strong-admin-password

SIMBAOS_PORT=8080
